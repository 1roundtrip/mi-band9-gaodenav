# ===== 签名与密钥：绝不提交 =====
*.jks
*.p12
*.pem
*.keystore
keys/
android-app/libs/*.jar
android-app/libs/*.txt
!android-app/libs/.gitkeep

# ===== 第三方依赖（tools/fetch-deps 生成，不入库）=====
# 高德 SDK / 小米互联 SDK 都是别人的代码，许可证不允许转分发
third_party/AMapNavi/*
third_party/r8/*
!third_party/AMapNavi/.gitkeep
.cache/

# ===== 构建产物 =====
out/
dist/
build/
android-app/out/
android-app/dist/
band-app/dist/
band-app-pro/dist/
*.apk
*.rpk
*.dex
*.class
*.pyc
__pycache__/
node_modules/
/tmp/
# aiot 打包时的临时工程
.temp_*/
band-app*/.temp_*/

# ===== 手环工程的签名 PEM（由 tools/gen-signing 分发）=====
band-app*/sign/**/*.pem

# ===== 本地调试产物 / 个人工作记录：不入库 =====
# 装机截图（约 9 MB）体积大且随调试不断新增，交接时通过聊天/打包另行传递
screenshots/
# agent 工作日志（含本机路径、临时密码、调试流水）
.workbuddy/
# 图标预览临时渲染
.icon-preview/

# ===== IDE / 本地配置 =====
.idea/
.vscode/
*.iml
local.properties
